+    native + ' nav[aria-label="全局面板"],\n' + native + ' nav[aria-label="Global panels"] { display: none !important; }',
+    native + ' [data-slot="settings.launcher"] button[data-signed-out] > [class$="_label"] { display: none; }',
+    native + ' [data-slot="settings.launcher"] button[data-signed-out][data-collapsed="false"]::after { content: "设置"; }',
+    native + ' [class*="_logoRow"] > [class*="_brand"] { display: none !important; }',
