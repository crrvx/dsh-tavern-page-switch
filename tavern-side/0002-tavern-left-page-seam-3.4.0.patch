diff --git a/tests/left-page-seam.test.mjs b/tests/left-page-seam.test.mjs
new file mode 100644
index 0000000..3b9d7a6
--- /dev/null
+++ b/tests/left-page-seam.test.mjs
@@ -0,0 +1,244 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import vm from "node:vm";
+import { spawnSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+
+const REPO = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const SIDEBAR = path.join(REPO, "tavern-plugin/src/client/features/sidebar.js");
+const MAIN = path.join(REPO, "tavern-plugin/src/client/main.js");
+const CSS = path.join(REPO, "tavern-plugin/lib/client-assets/tavern.css");
+const BUILT = path.join(REPO, "tavern-plugin/lib/client.js");
+
+const sidebarSource = fs.readFileSync(SIDEBAR, "utf8");
+const mainSource = fs.readFileSync(MAIN, "utf8");
+const cssSource = fs.readFileSync(CSS, "utf8");
+const builtSource = fs.existsSync(BUILT) ? fs.readFileSync(BUILT, "utf8") : "";
+
+function extractSeamModule() {
+  const start = sidebarSource.indexOf("\t\tfunction createTavernLeftPageSeam(options) {");
+  const end = sidebarSource.indexOf("\t\tfunction createTavernShellFeatureModule() {");
+  assert.ok(start >= 0, "createTavernLeftPageSeam is defined at the top of sidebar.js");
+  assert.ok(end > start, "the seam helpers precede createTavernShellFeatureModule");
+  const sandbox = { Object };
+  vm.createContext(sandbox);
+  vm.runInContext(sidebarSource.slice(start, end), sandbox);
+  return sandbox;
+}
+
+const seamModule = extractSeamModule();
+const { createTavernLeftPageSeam, installTavernLeftPage } = seamModule;
+
+function makeSeam() {
+  const log = [];
+  const seam = createTavernLeftPageSeam({
+    mountPage: () => log.push("mount"),
+    unmountPage: () => log.push("unmount"),
+    requestExpand: () => log.push("expand"),
+    cancelExpand: () => log.push("cancel")
+  });
+  return { seam, log };
+}
+
+test("the page is one frozen tavern page with idempotent attach/detach", () => {
+  const { seam, log } = makeSeam();
+  assert.equal(seam.page.id, "tavern");
+  assert.equal(seam.page.title, "酒馆");
+  assert.equal(Object.isFrozen(seam.page), true);
+  assert.equal(Object.isFrozen(seam), true);
+  assert.equal(seam.isAttached(), false);
+  seam.attach();
+  seam.attach({ returning: true });
+  assert.deepEqual(log, ["mount"]);
+  assert.equal(seam.isAttached(), true);
+  seam.detach();
+  seam.detach();
+  assert.deepEqual(log, ["mount", "cancel", "unmount"]);
+  assert.equal(seam.isAttached(), false);
+});
+
+test("returning from the native page asks for one expand before mounting", () => {
+  const { seam, log } = makeSeam();
+  seam.attach({ returning: true });
+  assert.deepEqual(log, ["expand", "mount"]);
+  seam.detach();
+  assert.deepEqual(log, ["expand", "mount", "cancel", "unmount"]);
+});
+
+test("a fresh mount does not expand a column the user left collapsed", () => {
+  const { seam, log } = makeSeam();
+  seam.attach({ returning: false });
+  seam.detach();
+  seam.attach();
+  assert.deepEqual(log, ["mount", "cancel", "unmount", "mount"]);
+  assert.equal(log.includes("expand"), false);
+});
+
+test("install attaches the page, registers with an already-provided service, and unregisters on cleanup", () => {
+  const log = [];
+  const registered = [];
+  const service = {
+    getMode: () => "tavern",
+    registerPage(page) {
+      registered.push(page);
+      log.push("register");
+      page.attach({ returning: false });
+      return () => log.push("unregister");
+    }
+  };
+  const ctx = {
+    get: (name) => (name === "tavernPageSwitch" ? service : null),
+    inject: () => { throw new Error("the provided service must be used before ctx.inject"); }
+  };
+  const cleanup = installTavernLeftPage(ctx, {
+    mountPage: () => log.push("mount"),
+    unmountPage: () => log.push("unmount"),
+    requestExpand: () => log.push("expand"),
+    cancelExpand: () => log.push("cancel")
+  });
+  assert.deepEqual(log, ["register", "mount"]);
+  assert.equal(registered.length, 1);
+  assert.equal(registered[0].id, "tavern");
+  cleanup();
+  assert.deepEqual(log, ["register", "mount", "unregister", "cancel", "unmount"]);
+});
+
+test("a provided service already in native mode never mounts the Tavern page", () => {
+  const log = [];
+  const service = {
+    getMode: () => "native",
+    registerPage() { log.push("register"); return () => log.push("unregister"); }
+  };
+  const ctx = { get: () => service };
+  const cleanup = installTavernLeftPage(ctx, {
+    mountPage: () => log.push("mount"),
+    unmountPage: () => log.push("unmount"),
+    requestExpand: () => log.push("expand"),
+    cancelExpand: () => log.push("cancel")
+  });
+  assert.deepEqual(log, ["register"]);
+  cleanup();
+  assert.deepEqual(log, ["register", "unregister"]);
+});
+
+test("install falls back to a late ctx.inject binding when the service appears later", () => {
+  const log = [];
+  let lateCallback = null;
+  let lateDisposed = false;
+  const ctx = {
+    get: () => null,
+    inject(deps, callback) {
+      assert.equal(deps.length, 1);
+      assert.equal(deps[0], "tavernPageSwitch");
+      lateCallback = callback;
+      return () => { lateDisposed = true; };
+    }
+  };
+  const cleanup = installTavernLeftPage(ctx, {
+    mountPage: () => log.push("mount"),
+    unmountPage: () => log.push("unmount"),
+    requestExpand: () => log.push("expand"),
+    cancelExpand: () => log.push("cancel")
+  });
+  assert.deepEqual(log, ["mount"]);
+  const service = {
+    registerPage(page) {
+      log.push("register:" + page.id);
+      return () => log.push("unregister");
+    }
+  };
+  lateCallback({ get: (name) => (name === "tavernPageSwitch" ? service : null) });
+  assert.deepEqual(log, ["mount", "register:tavern"]);
+  cleanup();
+  assert.deepEqual(log, ["mount", "register:tavern", "unregister", "cancel", "unmount"]);
+  assert.equal(lateDisposed, true);
+});
+
+test("a late service in native mode detaches the already-mounted Tavern page", () => {
+  let lateCallback = null;
+  const log = [];
+  const ctx = {
+    get: () => null,
+    inject(deps, callback) { lateCallback = callback; return () => {}; }
+  };
+  const cleanup = installTavernLeftPage(ctx, {
+    mountPage: () => log.push("mount"),
+    unmountPage: () => log.push("unmount"),
+    requestExpand: () => log.push("expand"),
+    cancelExpand: () => log.push("cancel")
+  });
+  lateCallback({
+    get: () => ({
+      getMode: () => "native",
+      registerPage(page) { log.push("register:" + page.id); return () => log.push("unregister"); }
+    })
+  });
+  assert.deepEqual(log, ["mount", "register:tavern", "cancel", "unmount"]);
+  cleanup();
+  assert.deepEqual(log, ["mount", "register:tavern", "cancel", "unmount", "unregister"]);
+});
+
+test("a late service callback after cleanup does not register the page", () => {
+  let lateCallback = null;
+  const ctx = {
+    get: () => null,
+    inject(deps, callback) { lateCallback = callback; return () => {}; }
+  };
+  const log = [];
+  const cleanup = installTavernLeftPage(ctx, {
+    mountPage: () => log.push("mount"),
+    unmountPage: () => log.push("unmount"),
+    requestExpand: () => log.push("expand"),
+    cancelExpand: () => log.push("cancel")
+  });
+  cleanup();
+  let registerCalls = 0;
+  lateCallback({ get: () => ({ registerPage: () => { registerCalls += 1; } }) });
+  assert.equal(registerCalls, 0);
+  assert.deepEqual(log, ["mount", "cancel", "unmount"]);
+});
+
+test("a plain Tavern install without the plugin keeps the page mounted", () => {
+  const log = [];
+  const ctx = { get: () => null };
+  const cleanup = installTavernLeftPage(ctx, {
+    mountPage: () => log.push("mount"),
+    unmountPage: () => log.push("unmount")
+  });
+  assert.deepEqual(log, ["mount"]);
+  cleanup();
+  assert.deepEqual(log, ["mount", "unmount"]);
+});
+
+test("the shell wires the left page through a single effect and exports the seam", () => {
+  assert.match(sidebarSource, /installTavernLeftPage\(ctx, \{/);
+  assert.match(sidebarSource, /\}, "dsh-tavern: left page"\);/);
+  assert.equal(sidebarSource.includes("dsh-tavern: sidebar brand mark"), false);
+  assert.equal(sidebarSource.includes("dsh-tavern: Tavern workspace browser"), false);
+  assert.match(mainSource, /exports\.createTavernLeftPageSeam = createTavernLeftPageSeam;/);
+  assert.match(mainSource, /exports\.installTavernLeftPage = installTavernLeftPage;/);
+});
